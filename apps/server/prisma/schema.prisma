datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  member
  admin
}

enum CustomDomainStatus {
  pending
  verified
  active
  failed
}

enum PermissionRole {
  viewer
  editor
  manager
}

// PermissionSubjectType enum was removed in the A3 cutover — Permission rows
// now use nullable userId + groupId (XOR-checked) instead of a discriminator.
// The API request shape still accepts subjectType: "user" | "group" as a plain
// string union; see apps/server/src/permissions/routes.ts.

enum PermissionResourceType {
  folder
  document
}

enum ChangeSource {
  web_app
  obsidian_plugin
  agent
  import
  system
}

// First-class lifecycle for a document. `canonical` is the live source of truth;
// `superseded` rows are kept for history but ranked below canonical in search and
// flagged in the UI so agents do not implement from outdated plans.
enum DocumentStatus {
  canonical
  draft
  superseded
  archived
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String? // argon2id; null for OAuth-only accounts
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  workspaceMemberships    WorkspaceMembership[]
  groupMemberships        GroupMembership[]
  createdDocuments        Document[]               @relation("DocumentCreatedBy")
  updatedDocuments        Document[]               @relation("DocumentUpdatedBy")
  createdFolders          Folder[]                 @relation("FolderCreatedBy")
  updatedFolders          Folder[]                 @relation("FolderUpdatedBy")
  revisions               DocumentRevision[]
  sessionVersion          Int                      @default(0)
  emailVerified           Boolean                  @default(false)
  apiTokens               ApiToken[]
  auditEvents             AuditEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  mcpOAuthCodes           McpOAuthCode[]
  uploadedAttachments     Attachment[]             @relation("AttachmentUploadedBy")
  authoredComments        DocumentComment[]        @relation("DocumentCommentAuthor")
  resolvedComments        DocumentComment[]        @relation("DocumentCommentResolver")
  documentReadCursors     TokenReadCursor[]        @relation("TokenReadCursorUser")
  documentClaims          DocumentClaim[]          @relation("DocumentClaimUser")
  permissions             Permission[]             @relation("PermissionUser")
  documentShares          DocumentShare[]          @relation("DocumentShareCreator")
}

model Workspace {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  subdomain              String?               @unique
  customDomain           String?               @unique
  customDomainStatus     CustomDomainStatus    @default(pending)
  customDomainVerifiedAt DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  members                WorkspaceMembership[]
  groups                 Group[]
  folders                Folder[]
  documents              Document[]
  permissions            Permission[]
  auditEvents            AuditEvent[]
  attachments            Attachment[]
  mcpOAuthCodes          McpOAuthCode[]
  comments               DocumentComment[]
  readCursors            TokenReadCursor[]
  claims                 DocumentClaim[]
  shares                 DocumentShare[]
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Group {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  permissions Permission[]      @relation("PermissionGroup")

  @@unique([workspaceId, slug])
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// M7: createdBy/updatedBy are now real relations, and Folder gets soft-delete parity
// with Document so the partial-unique migration (B4) can cover both tables.
model Folder {
  id             String          @id @default(cuid())
  workspaceId    String
  parentFolderId String?
  name           String
  slug           String
  path           String
  // Default role floor for any workspace member on documents in this folder (and
  // descendants when no closer ancestor sets one). null = private, the historical
  // behavior — only explicit grants apply. Set to "viewer" or "editor" to make a
  // folder "open" to all members without N explicit permission rows.
  defaultRole    PermissionRole?
  createdById    String
  updatedById    String
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentFolder   Folder?         @relation("FolderTree", fields: [parentFolderId, workspaceId], references: [id, workspaceId])
  childFolders   Folder[]        @relation("FolderTree")
  createdBy      User            @relation("FolderCreatedBy", fields: [createdById], references: [id])
  updatedBy      User            @relation("FolderUpdatedBy", fields: [updatedById], references: [id])
  documents      Document[]

  // Path and sibling slug uniqueness are enforced by PARTIAL unique indexes
  // in a raw migration, so soft-deleted rows do not block reuse.
  @@unique([id, workspaceId])
  @@index([workspaceId, parentFolderId])
}

model Document {
  id               String             @id @default(cuid())
  workspaceId      String
  folderId         String
  title            String
  slug             String
  path             String
  currentVersionId String? // == the wire `version`; FK-free to avoid a write cycle
  currentChecksum  String?
  searchText       String? // denormalized current content for full-text search
  // Canonical/superseded metadata is parsed from frontmatter on every write so the field is
  // first-class: search ranks canonical above superseded, MCP can filter to canonical only,
  // and the doc viewer shows a "superseded by" banner pointing at the replacement.
  status           DocumentStatus     @default(canonical)
  supersededById   String?
  createdById      String
  updatedById      String
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder           Folder             @relation(fields: [folderId, workspaceId], references: [id, workspaceId])
  createdBy        User               @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedBy        User               @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  supersededBy     Document?          @relation("DocumentSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       Document[]         @relation("DocumentSupersession")
  revisions        DocumentRevision[]
  attachments      Attachment[]
  comments         DocumentComment[]
  readCursors      TokenReadCursor[]
  claims           DocumentClaim[]
  shares           DocumentShare[]

  // Path and sibling slug uniqueness are enforced by PARTIAL unique indexes
  // in a raw migration, so soft-deleted rows do not block reuse.
  @@index([workspaceId, folderId])
  @@index([workspaceId, status])
  @@index([currentVersionId])
  @@index([supersededById])
}

// Inline review comment scoped to a document, optionally anchored to a heading.
// Authored by a user (web) or an agent token (MCP). Comments don't gate writes —
// they're a coordination signal so multiple agents can leave notes on a plan
// without rewriting prose, and so an editor can see open questions at a glance.
model DocumentComment {
  id            String    @id @default(cuid())
  workspaceId   String
  documentId    String
  sectionAnchor String? // null = comment on the whole doc; otherwise the heading anchor slug
  authorUserId  String?
  authorTokenId String?
  authorLabel   String? // human-friendly label captured at write time (token name, etc.)
  body          String
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorUser    User?     @relation("DocumentCommentAuthor", fields: [authorUserId], references: [id])
  authorToken   ApiToken? @relation("DocumentCommentAuthorToken", fields: [authorTokenId], references: [id])
  resolvedBy    User?     @relation("DocumentCommentResolver", fields: [resolvedById], references: [id])

  @@index([documentId, resolvedAt])
  @@index([workspaceId, resolvedAt])
}

// Per-token (or per-user) bookmark: where this caller was the last time they
// read this document. Used by pageden_my_unread to answer "what changed since
// I last looked?" without scanning every revision row.
model TokenReadCursor {
  id              String    @id @default(cuid())
  tokenId         String?
  userId          String?
  workspaceId     String
  documentId      String
  lastReadVersion String?
  lastReadAt      DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token           ApiToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user            User?     @relation("TokenReadCursorUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenId, documentId])
  @@unique([userId, documentId])
  @@index([workspaceId, lastReadAt])
}

// Soft "I'm working on this doc" claim. Not a lock — writes still go through
// the row-locked applyDocumentWrite path. The dashboard surfaces active claims
// so concurrent agents can coordinate ("Codex already has this one").
model DocumentClaim {
  id          String    @id @default(cuid())
  workspaceId String
  documentId  String
  tokenId     String?
  userId      String?
  actorLabel  String? // human-readable label captured at claim time
  note        String?
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token       ApiToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user        User?     @relation("DocumentClaimUser", fields: [userId], references: [id])

  @@index([workspaceId, releasedAt, expiresAt])
  @@index([documentId, releasedAt, expiresAt])
}

model DocumentRevision {
  id              String       @id @default(cuid()) // this id is the wire `version`/`baseVersion`
  documentId      String
  versionNumber   Int // display only
  storageKey      String // content-addressed (checksum-derived); immutable
  checksum        String
  createdById     String
  createdAt       DateTime     @default(now())
  changeSource    ChangeSource
  message         String?
  revisionGroupId String?
  contributorIds  String[]     @default([])
  isPinned        Boolean      @default(false)
  label           String?
  prunedAt        DateTime?
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy       User         @relation(fields: [createdById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([documentId, revisionGroupId, versionNumber])
  @@index([documentId, prunedAt])
}

model Permission {
  id           String                 @id @default(cuid())
  workspaceId  String
  // A3 cutover: subjectType/subjectId discriminator columns have been dropped.
  // userId XOR groupId is enforced at the DB level by Permission_user_xor_group_check.
  // Uniqueness is enforced by partial unique indexes (one for users, one for
  // groups) added in the raw migration so a row's (user|group, resource) pair
  // appears at most once.
  userId       String?
  groupId      String?
  resourceType PermissionResourceType
  resourceId   String
  role         PermissionRole
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?                  @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  group        Group?                 @relation("PermissionGroup", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resourceType, resourceId])
  @@index([userId])
  @@index([groupId])
}

// B5: token lookup must be deterministic, so tokenHash is HMAC-SHA256(token, TOKEN_HASH_SECRET).
// Never bcrypt/argon2 here — those are salted and cannot be looked up by hash.
model ApiToken {
  id               String            @id @default(cuid())
  userId           String
  name             String
  kind             String            @default("personal") // personal | obsidian | agent
  scopes           String[]          @default(["search", "read", "create", "update", "append", "attachments"])
  workspaceId      String?
  tokenHash        String            @unique // HMAC-SHA256, keyed by TOKEN_HASH_SECRET
  lastUsedAt       DateTime?
  lastUsedIp       String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  authoredComments DocumentComment[] @relation("DocumentCommentAuthorToken")
  readCursors      TokenReadCursor[]
  claims           DocumentClaim[]

  @@index([userId])
  @@index([kind])
  @@index([workspaceId])
}

// Device-code login (M6): the Obsidian plugin starts a request, the user approves it in the
// web app by entering the short userCode, then the plugin polls and receives a token once.
model DeviceAuthRequest {
  id             String    @id @default(cuid())
  userCode       String    @unique // short, human-entered approval code (one-time, short-lived)
  deviceCodeHash String    @unique // HMAC of the secret device code the plugin polls with
  status         String    @default("pending") // pending | approved | denied | consumed
  userId         String?
  tokenId        String?
  approvedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  ipAddress      String?

  @@index([expiresAt])
}

model AuditEvent {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  targetType  String
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

model Attachment {
  id           String    @id @default(cuid())
  workspaceId  String
  documentId   String
  filename     String
  contentType  String
  size         Int
  sha256       String // sha256 hex of the stored bytes
  storageKey   String // content-addressed posix key under attachments/
  uploadedById String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([documentId, deletedAt])
  @@index([workspaceId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // HMAC-SHA256 of the raw token; the raw token is only emailed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // e.g. "google"
  providerAccountId String // the provider's stable subject id
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model McpOAuthCode {
  id            String    @id @default(cuid())
  jti           String    @unique
  codeHash      String?   @unique // HMAC of the opaque authorization code returned to the client
  userId        String
  workspaceId   String
  clientId      String
  redirectUri   String
  codeChallenge String? // PKCE S256 challenge; nullable only for pre-migration short-lived rows
  scopes        String[]  @default([])
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([workspaceId])
}

// Public share link for a single document. Anonymous /s/:slug returns sanitized
// Markdown when the share is unrevoked, unexpired, and the (optional) password
// matches. Subtree / folder-scoped sharing is deliberately deferred per the
// accepted decision in pageden-dev/docs/permission-model-review-outline-docmost.md
// — `includeFolderDocuments` will be added in a follow-up if real usage demands it.
model DocumentShare {
  id            String    @id @default(cuid())
  workspaceId   String
  documentId    String
  slug          String    @unique // random URL-safe token
  passwordHash  String? // HMAC-SHA256 of the share password if one was set
  allowIndexing Boolean   @default(false) // when true the public route may be crawled
  expiresAt     DateTime? // null = never expires
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("DocumentShareCreator", fields: [createdById], references: [id])

  @@index([workspaceId, revokedAt, expiresAt])
  @@index([documentId, revokedAt])
}
