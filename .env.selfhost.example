# Pageden self-hosted Docker configuration
# Copy to .env and replace all CHANGE_ME values before starting the stack.

# Local image tags used when Docker Compose builds from this checkout.
# Advanced users may override these with published image tags when available.
PAGEDEN_SERVER_IMAGE=pageden-server:selfhost
PAGEDEN_WEB_IMAGE=pageden-web:selfhost

# Public web port on the Docker host.
PAGEDEN_WEB_PORT=3000

# PostgreSQL. Use URL-safe characters in POSTGRES_PASSWORD because the compose
# file builds DATABASE_URL from these values.
POSTGRES_DB=pageden
POSTGRES_USER=pageden
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password

# Public URL users visit. For local testing keep localhost. For production, set
# both values to the HTTPS origin served by your reverse proxy.
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Required application secrets. Generate each with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
TOKEN_HASH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Self-host mode and persistent local filesystem storage.
CLOUD_HOSTED=false
STORAGE_DRIVER=fs
STORAGE_ROOT=/data/storage

# First admin account created by the one-shot seed container.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_admin_password

# Optional Google OAuth for self-hosted deployments. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ClamAV antivirus scanning (optional). The default compose stack includes a ClamAV
# sidecar and sets CLAMAV_URL=tcp://clamav:3310 in the server environment.
# To disable scanning: remove the clamav service from docker-compose.selfhost.yml
# and remove the CLAMAV_URL env var from the server section. Files will then be
# marked READY immediately without being scanned.
# CLAMAV_URL=tcp://clamav:3310
